# 本地配置模板：复制为 backend/.env 后填写真实密钥。
# backend/.env 已被 Git 忽略，真实 API Key 不要提交。

# 主模型回退配置（关闭分层 Agent 时仍可使用）。
MODEL_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_API_STYLE=chat_completions

# 分层 Agent：Planner 负责判断、规划和汇总；Worker 只执行简单子任务。
AGENT_HIERARCHY_ENABLED=true
PLANNER_PROVIDER=deepseek
PLANNER_MODEL=deepseek-v4-flash-vision-exp
PLANNER_API_KEY=
PLANNER_BASE_URL=https://api.deepseek.com/
WORKER_PROVIDER=deepseek
WORKER_MODEL=deepseek-v4-flash-vision-exp
WORKER_API_KEY=
WORKER_BASE_URL=https://api.deepseek.com/
WORKER_MAX_STEPS=4
WORKER_MAX_TOOL_ROUNDS=3
WORKER_MAX_OUTPUT_TOKENS=2048

# 网页搜索：auto 在存在 TAVILY_API_KEY 时使用 Tavily，否则使用 DuckDuckGo。
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5
